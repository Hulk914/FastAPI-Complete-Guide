# Copy to .env, then generate a PRIVATE key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-generated-secret-key
DATABASE_URL=sqlite:///./data/app.db
ACCESS_TOKEN_EXPIRE_MINUTES=20
JWT_ISSUER=products-api
JWT_AUDIENCE=products-api-users
# JSON array. Add your deployment hostname before serving it.
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
